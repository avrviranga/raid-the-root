# Shell scripts and config MUST use LF endings, even when cloned on Windows.
# Without this, bash fails with: bad interpreter: /usr/bin/env bash^M
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
.env.template text eol=lf

# Binary challenge artefacts - never transform these.
*.png   binary
*.jpg   binary
*.pcap  binary
*.enc   binary
*.zip   binary
